NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
DATABASE_POOL_MAX=10

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo

SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_WAIT_TIME_SECONDS=10
SQS_CONSUMER_BATCH_SIZE=10
SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_MAX_ATTEMPTS=5
SQS_CONSUMER_RETRY_BASE_DELAY_MS=1000
SQS_CONSUMER_RETRY_MAX_DELAY_MS=60000
SQS_CONSUMER_SHUTDOWN_TIMEOUT_MS=20000

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=10
OUTBOX_IDLE_DELAY_MS=500
OUTBOX_PUBLISH_TIMEOUT_MS=5000

REFERENCE_WORKER_ENABLED=true
REFERENCE_WORKER_BATCH_SIZE=20
REFERENCE_WORKER_IDLE_DELAY_MS=1000
REFERENCE_CHECK_MAX_ATTEMPTS=15
